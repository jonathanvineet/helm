{
  "manifest_version": 3,
  "name": "Helm",
  "version": "0.1.0",
  "description": "Watches pages you're waiting on and tells you when they change.",
  "key": "",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Helm",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
